# Exemplo fictício. Copie para .env (ignorado) e configure localmente.
APP_ENV=development
LOG_LEVEL=INFO
# Deixe todos vazios até obter os valores reais do seu serviço Aiven.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL_MODE=VERIFY_IDENTITY
DATABASE_SSL_CA_PATH=
DATABASE_CONNECT_TIMEOUT=5
DATABASE_READ_TIMEOUT=5
DATABASE_WRITE_TIMEOUT=5
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE=300
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_TIMEZONE=America/Sao_Paulo
DEMO_MODE=true
DEMO_USER_ID=1
# API normal exige JWT. demo é somente uma opção local explícita, proibida em produção.
AUTH_MODE=jwt
# Gere uma vez localmente (mínimo 32 bytes aleatórios). Nunca versionar o valor.
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Somente demonstração no PC local. Proibido em APP_ENV=production.
SIMULATOR_MODE=false
SIMULATOR_ALLOWED_ORIGINS=["http://127.0.0.1:5500"]
